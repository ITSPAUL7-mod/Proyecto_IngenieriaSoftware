<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox   xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml"
        spacing="15.0" style="-fx-background-color: #ffffff; -fx-padding: 20;"
        fx:controller="com.backit.desktop.prototipo.ModuloBosquejoController">
   <children>
      <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="Modulo de Devolucion Fisica y Validacion QR" />
      <HBox spacing="20.0" VBox.vgrow="ALWAYS">
         <children>
            <VBox prefWidth="420.0" spacing="15.0" style="-fx-background-color: #f8fafc; -fx-padding: 20; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
               <children>
                  <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Escaneo / Validacion de Codigo QR" />
                  <TextField fx:id="txtCodigoQR" promptText="Ingrese o escanee el UUID del QR..." style="-fx-font-size: 14px;" />
                  <Button fx:id="btnValidarQR" maxWidth="1.7976931348623157E308" onAction="#handleValidarQR" style="-fx-background-color: #0284c7; -fx-text-fill: white; -fx-font-weight: bold;" text="Validar Token QR" />
                  <Separator />
                  <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Datos de Devolucion Presencial" />
                  <Label fx:id="lblObjetoInfo" text="Objeto: (Pendiente de escaneo)" />
                  <Label fx:id="lblReclamanteInfo" text="Reclamante: (Pendiente)" />
                  <Button fx:id="btnConfirmarEntrega" disable="true" maxWidth="1.7976931348623157E308" onAction="#handleConfirmarEntrega" style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-height: 42;" text="Confirmar Entrega y Registrar Devolucion" />
               </children>
            </VBox>
            <VBox prefWidth="400.0" spacing="15.0" style="-fx-background-color: #fafafa; -fx-padding: 20; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
               <children>
                  <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Valoracion del Servicio" />
                  <Label text="Calificacion del proceso de devolucion:" />
                  <Slider fx:id="sliderCalificacion" blockIncrement="1.0" majorTickUnit="1.0" max="5.0" min="1.0" minorTickCount="0" showTickLabels="true" showTickMarks="true" value="5.0" />
                  <TextArea fx:id="txtComentarioValoracion" prefHeight="100.0" promptText="Comentario sobre el servicio de custodia..." wrapText="true" />
                  <Button fx:id="btnEnviarValoracion" maxWidth="1.7976931348623157E308" onAction="#handleEnviarValoracion" style="-fx-background-color: #475569; -fx-text-fill: white;" text="Enviar Calificacion" />
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</VBox>
